# SyncedIn — Fastlane config for CI/CD mobile releases.
#
# Two lanes:
#   bundle exec fastlane ios beta       → archive + upload to TestFlight
#   bundle exec fastlane android beta   → build AAB + upload to Play Internal
#
# Both auto-bump the build number (CFBundleVersion / versionCode) based on
# the latest already-uploaded build, so you never have to manually edit
# the build number again. Marketing version (1.0, 1.1, ...) stays
# committed in the repo and is the source of truth.

# --------------------------------------------------------------------- iOS
platform :ios do
  desc "Archive + upload to TestFlight (Public Beta external group)"
  lane :beta do
    # Pull a fresh App Store Connect API key in-memory.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      duration: 1200,
      in_house: false
    )

    # Auto-bump CFBundleVersion to (latest TestFlight build + 1). Means
    # we never collide with an earlier upload even if we forget to bump.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "org.syncedin.app",
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: latest + 1
    )

    # Automatic, Apple-managed signing driven by the App Store Connect API
    # key — no manual .p12 cert or downloaded provisioning profile needed
    # (the account already uses Xcode-managed signing). gym passes the API
    # key to xcodebuild and -allowProvisioningUpdates lets Apple create/
    # reuse the managed distribution cert + App Store profile on the fly.
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: true,
      team_id: "XCUTNS56DG"
    )
    # gym (build_app) has no api_key option, so we hand xcodebuild the App
    # Store Connect key directly: write the .p8 to disk and pass
    # -authenticationKeyPath/-authenticationKeyID/-authenticationKeyIssuerID
    # alongside -allowProvisioningUpdates. Without this the archive dies with
    # "No Accounts" / "No profiles for 'org.syncedin.app' were found" — the
    # CI runner has no Apple ID logged in, so the API key IS the account.
    # Both the archive (xcargs) and the export (export_xcargs) need it.
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_path = File.expand_path("AuthKey_#{key_id}.p8", __dir__)
    File.write(key_path, ENV["APP_STORE_CONNECT_API_KEY_CONTENT"])
    auth_args =
      "-authenticationKeyPath #{key_path} " \
      "-authenticationKeyID #{key_id} " \
      "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "SyncedIn.ipa",
      clean: true,
      # Archive needs the auth key explicitly (gym does NOT auto-inject it
      # here). The export step DOES get the key auto-injected by gym from the
      # app_store_connect_api_key context, so we must NOT repeat it in
      # export_xcargs or xcodebuild errors: "-authenticationKeyPath may only
      # be provided once". Export only needs -allowProvisioningUpdates.
      xcargs: "-allowProvisioningUpdates #{auth_args}",
      export_xcargs: "-allowProvisioningUpdates",
      export_options: {
        signingStyle: "automatic"
      }
    )

    # Upload to TestFlight. Skip waiting for processing so the CI job
    # finishes fast — App Store Connect handles processing async and the
    # auto-distribute setting on the Public Beta group picks it up.
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/ios/SyncedIn.ipa",
      skip_waiting_for_build_processing: true,
      changelog: build_changelog
    )
  end

  # Format the last 5 commits as the TestFlight "What to Test" notes so
  # testers see what changed since the last upload.
  def build_changelog
    log = `git log -5 --pretty=format:"• %s" 2>/dev/null`.to_s.strip
    log.empty? ? "Bug fixes and improvements." : log
  end
end

# --------------------------------------------------------------------- Android
platform :android do
  desc "Build AAB + upload to Play Console Internal Testing"
  lane :beta do
    # versionCode = current Unix epoch seconds. This is always strictly
    # increasing (time only moves forward) and is globally unique across
    # EVERY Play track + draft, so we can never collide with a code that's
    # already been used (the failure mode of querying a single track's max
    # and adding 1 — a code can exist in a draft/other track and 'max+1'
    # still collides). Epoch seconds in this era (~1.78e9) sit well under
    # Play's 2.1e9 versionCode ceiling, with headroom past 2030.
    play_json = "fastlane/play-service-account.json"
    next_code = Time.now.to_i

    android_set_version_code(
      version_code: next_code,
      gradle_file: "android/app/build.gradle"
    )

    # Build signed AAB.
    gradle(
      project_dir: "android",
      task: "bundleRelease",
      properties: {
        "android.injected.signing.store.file" => File.expand_path(
          "../android/app/release.keystore", __dir__
        ),
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    # Upload to Play Console Internal Testing track. We now ALSO push the
    # store-listing hi-res icon (fastlane/metadata/android/en-US/images/
    # icon.png) so the Play Store page stops showing the auto-generated
    # "infinity" placeholder. Text metadata + screenshots stay skipped, so
    # only the icon image is touched.
    upload_to_play_store(
      package_name: "org.syncedin.app",
      track: "internal",
      json_key: play_json,
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: false,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end
